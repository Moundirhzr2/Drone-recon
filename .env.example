# Copier ce fichier en .env pour changer de fond de scène.
# Par défaut (aucun .env), le simulateur tourne en mode hors-ligne : aucune clé requise.

# offline | ion | google
VITE_WORLD_BACKEND=offline

# Mode "ion" : terrain mondial Cesium + bâtiments OSM 3D.
# Token gratuit sur https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Mode "google" : tuiles photoréalistes (Google Map Tiles API).
# Attention : facturé à l'usage. https://developers.google.com/maps/documentation/tile
VITE_GOOGLE_MAPS_KEY=
