# Copier ce fichier en .env.local pour activer la ville photoréaliste.
# Sans clé, le simulateur dessine la ville d'après les données de l'IGN :
# aucune clé n'est nécessaire.

# Ville photoréaliste (relevé 3D de Google, celui de Google Earth), par Cesium ion.
# Jeton gratuit sur https://ion.cesium.com/tokens, après avoir ajouté
# « Google Photorealistic 3D Tiles » à ses ressources depuis l'Asset Depot.
VITE_CESIUM_ION_TOKEN=

# Ou directement chez Google (Map Tiles API), facturé à l'usage :
# https://developers.google.com/maps/documentation/tile
VITE_GOOGLE_MAPS_KEY=
